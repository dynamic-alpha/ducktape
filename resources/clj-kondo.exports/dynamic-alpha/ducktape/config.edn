;; clj-kondo config shipped with ducktape.
;;
;; Downstream consumers pick this up automatically when they run
;;   clj-kondo --copy-configs --dependencies --lint "$(clojure -Spath)"
;;
;; The hooks teach clj-kondo about the vars generated by the FFI macros
;; in `ducktape.ffi` so callers don't see "Unresolved var" warnings.
{:hooks
 {:analyze-call
  {ducktape.ffi/define-ffi-fns!        hooks.ducktape.ffi/define-ffi-fns!
   ducktape.ffi/define-type-constants! hooks.ducktape.ffi/define-type-constants!}}}
